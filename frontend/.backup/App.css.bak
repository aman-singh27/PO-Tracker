/* Page-specific composition; tokens and shadcn-style primitives live in index.css/shell.css. */
.page{max-width:1280px;margin:0 auto}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.page-header h1{font-size:1.5rem;margin:.15rem 0}.eyebrow{font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-foreground);margin:0}.subtle,.helper{color:var(--muted-foreground);font-size:.8125rem}.subtle{margin:.25rem 0 0}.stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-bottom:1.5rem}.stat-grid .card{padding:1.25rem}.stat-grid p,.stat-grid small{color:var(--muted-foreground);margin:0}.stat-num{display:block;font-size:1.5rem;margin:.5rem 0}.money-outstanding{color:var(--money-outstanding,#8f5e00)}.table-card{overflow:hidden}.table-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;border-bottom:1px solid var(--border)}.search-field{display:flex;align-items:center;gap:.5rem;max-width:340px;width:100%;color:var(--muted-foreground)}.search-field .input{min-height:36px}.grid-wrap{overflow-x:auto}.data-table{border-collapse:collapse;width:100%;font-size:.8125rem;white-space:nowrap}.data-table th{height:40px;background:color-mix(in oklab,var(--muted),transparent 35%);font-size:.6875rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-foreground);text-align:left}.data-table th,.data-table td{padding:.625rem .875rem;border-bottom:1px solid var(--border)}.data-table tbody tr{height:52px}.line-table tbody tr,.line-grid tbody tr{height:36px}.data-table tbody tr:nth-child(even){background:color-mix(in oklab,var(--muted),transparent 65%)}.data-table tbody tr:hover{background:color-mix(in oklab,var(--primary),transparent 93%)}.data-table a{color:var(--primary);font-weight:600}.review-row{border-left:3px solid var(--status-review-fg,#ad6500)}.empty-state{text-align:center;padding:3rem 1rem}.empty-state p{color:var(--muted-foreground);font-size:.875rem}.inline-alert,.form-error{background:#fee9e6;color:#a73627;border-radius:var(--radius);padding:.75rem 1rem;margin:1rem}.metadata{display:grid;grid-template-columns:repeat(3,1fr);padding:.75rem;margin-bottom:1rem}.metadata>div{display:grid;grid-template-columns:18px 1fr;gap:.15rem .5rem;padding:.5rem 1rem;border-right:1px solid var(--border)}.metadata>div:last-child{border:0}.metadata svg{grid-row:span 2;color:var(--muted-foreground)}.metadata small,.money-strip small{color:var(--muted-foreground);font-size:.75rem}.metadata strong{font-size:.875rem}.money-strip{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:1rem}.money-strip>div{padding:1rem;border-right:1px solid var(--border);display:grid;gap:.3rem}.money-strip>div:last-child{border:0}.money-strip strong{font-size:1.1rem}.money-strip span{font-size:.75rem;color:var(--muted-foreground)}.back-link{display:inline-flex;align-items:center;gap:.35rem;margin-bottom:1rem;color:var(--muted-foreground);text-decoration:none;font-size:.875rem}.form-card{padding:1.25rem;margin-bottom:1rem}.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.form-card label,.login-card label{display:grid;gap:.35rem;font-size:.75rem;font-weight:600}.optional{font-weight:400;color:var(--muted-foreground)}.section-heading h2,.pdf-review h2{font-size:1rem;margin:0}.section-heading p{margin:.25rem 0 1rem;color:var(--muted-foreground);font-size:.8125rem}.line-grid input,.line-grid select{width:100%;min-height:29px;border:1px solid transparent;background:transparent;padding:.15rem}.line-grid input:focus,.line-grid select:focus{outline:2px solid var(--ring);border-radius:3px;background:#fff}.form-actions{display:flex;align-items:center;gap:1rem;margin-top:1rem}.import-switch{display:flex;gap:.5rem;margin-bottom:1rem}.form-card textarea{width:100%;min-height:130px;padding:.75rem;margin-top:.25rem;border:1px solid var(--border);border-radius:var(--radius);resize:vertical}.pdf-review{padding:3rem;text-align:center;display:grid;justify-items:center;gap:.75rem}.pdf-review p{max-width:560px;color:var(--muted-foreground);margin:0}.severity{font-size:.6875rem;font-weight:700;text-transform:uppercase}.severity.warning{color:#8f5e00}.severity.error{color:#a73627}.login-page{min-height:100dvh;display:grid;place-items:center;background:var(--background);padding:1rem}.login-card{width:min(100%,400px);background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 10px 30px #13223812;padding:2rem;display:grid;gap:1rem}.login-card h1{letter-spacing:.08em;font-size:1.25rem;margin:0}.login-card p{margin:0;color:var(--muted-foreground);font-size:.875rem}.brand-mark{color:var(--primary);font-size:2rem}
@media(max-width:780px){.stat-grid,.form-grid{grid-template-columns:1fr}.metadata{grid-template-columns:repeat(2,1fr)}.metadata>div:nth-child(2){border-right:0}.money-strip{grid-template-columns:repeat(2,1fr)}.money-strip>div:nth-child(2){border-right:0}.page-header{align-items:flex-start}.table-toolbar{align-items:stretch;flex-direction:column}.search-field{max-width:none}.pdf-review{padding:2rem 1rem}}
