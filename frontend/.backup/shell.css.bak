.shell{min-height:100dvh;padding-left:248px}.sidebar{position:fixed;inset:0 auto 0 0;width:248px;background:var(--card);border-right:1px solid var(--border);padding:20px 12px;display:flex;flex-direction:column}.brand{font-weight:800;letter-spacing:.06em;padding:8px 12px 28px;color:#15233a}.brand span{color:var(--primary)}.brand small{display:block;font-size:10px;letter-spacing:.18em;margin-left:24px;color:var(--muted-foreground)}.sidebar nav{display:grid;gap:4px}.sidebar a{display:flex;gap:12px;align-items:center;padding:11px 12px;border-radius:8px;color:var(--muted-foreground);text-decoration:none;font-size:14px}.sidebar a.active,.sidebar a:hover{color:var(--primary);background:#e6f2ff}.profile{margin-top:auto;padding:12px}.profile small{display:block;text-transform:capitalize;color:var(--muted-foreground);margin:3px 0 14px}.topbar{height:64px;background:var(--card);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;padding:0 28px}.topbar .crumb,.slash{color:var(--muted-foreground);font-size:14px}.topbar kbd{margin-left:auto;color:var(--muted-foreground);border:1px solid var(--border);border-radius:5px;padding:3px 6px;font-size:11px}.mobile-menu{display:none}main{padding:28px;max-width:1600px}.btn{min-height:38px;border:1px solid transparent;border-radius:7px;padding:0 13px;display:inline-flex;gap:7px;align-items:center;justify-content:center;font-weight:600;font-size:14px;cursor:pointer}.btn:focus-visible,.input:focus-visible{outline:3px solid color-mix(in oklab,var(--primary),transparent 65%);outline-offset:2px}.btn:disabled{opacity:.5;cursor:not-allowed}.btn-default{background:var(--primary);color:white}.btn-secondary{background:var(--secondary);color:var(--secondary-foreground)}.btn-outline{background:transparent;border-color:var(--border);color:var(--foreground)}.btn-destructive{background:var(--destructive);color:white}.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 1px 2px #1322380d}.input{min-height:40px;width:100%;border:1px solid var(--border);border-radius:7px;background:white;padding:0 11px;color:var(--foreground)}.badge{display:inline-flex;align-items:center;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:700;line-height:1.25}.badge-neutral{background:#edf0f2;color:#46515e}.badge-ordered{background:#e8f2ff;color:#1769aa}.badge-part_billed{background:#f2ecff;color:#6641a8}.badge-billed{background:#e3f8ed;color:#137542}.badge-warning{background:#fff3d7;color:#8f5e00}.badge-danger{background:#fee9e6;color:#a73627}@media(max-width:780px){.shell{padding-left:0}.sidebar{display:none}.topbar{padding:0 16px}.mobile-menu{display:inline-flex}.topbar .crumb,.slash{display:none}main{padding:16px}.topbar kbd{display:none}}
