:root{--radius:.625rem;--background:oklch(.9784 .0011 197.1387);--foreground:oklch(.1884 .0128 248.5103);--card:#fff;--primary:oklch(.6723 .1606 244.9955);--primary-foreground:#fff;--secondary:oklch(.965 .003 240);--secondary-foreground:oklch(.1884 .0128 248.5103);--muted:oklch(.9222 .0013 286.3737);--muted-foreground:oklch(.554 .018 248.5103);--border:oklch(.9317 .0118 231.6594);--destructive:oklch(.6188 .2376 25.7658);--ring:oklch(.6818 .1584 243.354);font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--foreground);background:var(--background)}*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100dvh}button,input,select,textarea{font:inherit}.num{font-variant-numeric:tabular-nums;text-align:right}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip-link{position:absolute;left:-999px}.skip-link:focus{left:1rem;top:1rem;z-index:99;background:#fff;padding:.5rem}@media(prefers-reduced-motion:no-preference){*{transition:background-color .16s ease,color .16s ease,border-color .16s ease,opacity .16s ease}}
